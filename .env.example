# Environment Configuration Template
# Copy this file to .env and update with your values

# ===========================
# Application Environment
# ===========================
NODE_ENV=production

# ===========================
# API Configuration
# ===========================
PORT=3001
API_HOST=0.0.0.0

# ===========================
# Redis Configuration
# ===========================
# For local Docker deployment:
REDIS_URL=redis://redis:6379

# For Upstash (free tier - recommended for production):
# REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# ===========================
# Frontend Configuration
# ===========================
# For production with reverse proxy:
VITE_API_URL=/api

# For separate API server:
# VITE_API_URL=https://api.yourdomain.com

# For development with local custom domain:
# Add to /etc/hosts: 127.0.0.1 outpostgamesrgv.test

# ===========================
# Domain Configuration
# ===========================
# Update these in:
# - public/robots.txt
# - public/sitemap.xml  
# - index.html (canonical link)
# - nginx.prod.conf (server_name)
DOMAIN=outpostgamesrgv.com

# ===========================
# Square POS Integration
# ===========================
# Which credential pair below is actually used — "sandbox" or "production".
SQUARE_ENV=production

# Production Square credentials (Square Developer Dashboard > your app > Credentials).
# SQUARE_ACCESS_TOKEN=your-production-access-token
# SQUARE_APPLICATION_ID=your-production-application-id
# SQUARE_LOCATION_ID=your-production-location-id

# Sandbox credentials — only needed for local testing, never in production.
# SQUARE_SANDBOX_ACCESS_TOKEN=your-sandbox-access-token
# SQUARE_SANDBOX_APPLICATION_ID=your-sandbox-application-id
# SQUARE_SANDBOX_LOCATION_ID=your-sandbox-location-id

# ===========================
# Security
# ===========================
# Admin login (api/auth.js) — JSON array of { username, passwordHash }. One entry
# per person who needs /x/outpostAdmin access. Generate a bcrypt hash for a new
# password with (must run from api/ — bcryptjs is an API-only dependency):
#   cd api && node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" 'the-password'
# ADMIN_USERS=[{"username":"cody","passwordHash":"$2b$10$..."}]

# Extra origins allowed to make cross-origin API calls (comma-separated). The
# production domain and localhost dev ports are always allowed; only set this if
# VITE_API_URL points at a separate cross-origin API host.
# CORS_ALLOWED_ORIGINS=https://staging.outpostgamesrgv.com

# ===========================
# Monitoring (Optional)
# ===========================
# Sentry error tracking:
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics:
# GA_TRACKING_ID=G-XXXXXXXXXX

# ===========================
# Rate Limiting (Optional)
# ===========================
# Max requests per window
RATE_LIMIT_MAX=100

# Time window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW=900000

# ===========================
# Platform-Specific
# ===========================
# Fly.io automatically sets:
# - FLY_APP_NAME
# - FLY_REGION
# - FLY_ALLOC_ID
