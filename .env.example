# Environment Configuration Template
# Copy this file to .env and update with your values

# ===========================
# Application Environment
# ===========================
NODE_ENV=production

# ===========================
# API Configuration
# ===========================
PORT=3001
API_HOST=0.0.0.0

# ===========================
# Redis Configuration
# ===========================
# For local Docker deployment:
REDIS_URL=redis://redis:6379

# For Upstash (free tier - recommended for production):
# REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# ===========================
# Squarespace Commerce API (read-only product/inventory sync)
# ===========================
# Option A — Developer API Key (only available on Squarespace's Commerce Advanced
# plan: Settings > Advanced > Developer API Keys). Read-only scopes: Products, Inventory.
# If set, this is used instead of OAuth below — no other Squarespace vars are needed.
# SQUARESPACE_API_KEY=your-squarespace-read-only-api-key

# Descriptive User-Agent identifying this app (Squarespace requires one on Commerce
# API and OAuth token calls — used by both auth options below).
# SQUARESPACE_USER_AGENT=TheOutpostGames-Website/1.0

# Optional: cache time-to-live in ms before a background refresh (default 900000 = 15 min).
# SQUARESPACE_CACHE_TTL_MS=900000

# Option B — OAuth 2.0 (required on plans without Developer API Keys; see
# api/squarespaceOAuth.js). client_id/client_secret come from Squarespace's OAuth
# client registration review. redirect_uri must exactly match what was registered.
# After setting these and deploying, visit /api/squarespace/oauth/authorize once
# in a browser to complete the one-time human authorization step.
# SQUARESPACE_CLIENT_ID=your-oauth-client-id
# SQUARESPACE_CLIENT_SECRET=your-oauth-client-secret
# SQUARESPACE_REDIRECT_URI=https://outpostgamesrgv.com/api/squarespace/oauth/callback

# ===========================
# Frontend Configuration
# ===========================
# For production with reverse proxy:
VITE_API_URL=/api

# For separate API server:
# VITE_API_URL=https://api.yourdomain.com

# For development with local custom domain:
# Add to /etc/hosts: 127.0.0.1 outpostgamesrgv.test

# ===========================
# Domain Configuration
# ===========================
# Update these in:
# - public/robots.txt
# - public/sitemap.xml  
# - index.html (canonical link)
# - nginx.prod.conf (server_name)
DOMAIN=yourdomain.com

# ===========================
# Security (Optional)
# ===========================
# Add admin authentication if needed:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password

# JWT secret for sessions:
# JWT_SECRET=your-random-secret-key-here

# ===========================
# Monitoring (Optional)
# ===========================
# Sentry error tracking:
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics:
# GA_TRACKING_ID=G-XXXXXXXXXX

# ===========================
# Rate Limiting (Optional)
# ===========================
# Max requests per window
RATE_LIMIT_MAX=100

# Time window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW=900000

# ===========================
# Platform-Specific
# ===========================
# Fly.io automatically sets:
# - FLY_APP_NAME
# - FLY_REGION
# - FLY_ALLOC_ID
