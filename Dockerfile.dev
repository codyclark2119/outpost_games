# syntax=docker/dockerfile:1
# Local development image for docker-compose (local-dev).
# See Dockerfile.dev.dockerignore for what is excluded from the build context.
# Use: npm run docker:rebuild:web

FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json ./

# Cache npm downloads between rebuilds (~300MB saved per rebuild)
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
# nginx.compose.conf includes this in every location block; without it nginx
# refuses to start ("open() /etc/nginx/security-headers.conf failed").
COPY nginx.security-headers.conf /etc/nginx/security-headers.conf
COPY nginx.compose.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
