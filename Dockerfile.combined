# Multi-stage build for ultra-low-cost deployment
# Combines frontend, backend, and serves them from a single container
# Perfect for platforms that charge per container (Fly.io, Railway, etc.)

# ============================================
# Stage 1: Build Frontend
# ============================================
FROM node:22-alpine AS frontend-builder

WORKDIR /app

# Copy frontend package files
COPY package*.json ./

# Install dependencies
RUN npm ci --prefer-offline --no-audit

# Copy frontend source
COPY . .

# Build for production
RUN npm run build

# ============================================
# Stage 2: Build Backend
# ============================================
FROM node:22-alpine AS backend-builder

WORKDIR /app/api

# Copy API package files
COPY api/package*.json ./

# Install production dependencies only
RUN npm ci --omit=dev --prefer-offline --no-audit

# Copy API source
COPY api/ ./

# ============================================
# Stage 3: Production Runtime
# ============================================
FROM node:22-alpine

# Use the same Node major in build and runtime; tini reaps orphaned children.
RUN apk add --no-cache nginx wget tini && mkdir -p /etc/nginx/conf.d /run/nginx
COPY nginx.runtime.conf /etc/nginx/nginx.conf

WORKDIR /app

# Copy built frontend to nginx
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# Copy nginx configuration for combined container (localhost:3001)
COPY nginx.security-headers.conf /etc/nginx/security-headers.conf
COPY nginx.combined.conf /etc/nginx/conf.d/default.conf

# Copy backend
COPY --from=backend-builder /app/api /app/api

# Fix permissions
RUN chmod -R 755 /usr/share/nginx/html && \
    find /usr/share/nginx/html -type f -exec chmod 644 {} \; && \
    chmod +x /app/api/server.js

# Keep the supervisor script in source control so process handling is reviewable.
COPY startup.combined.sh /startup.sh
RUN chmod +x /startup.sh

# Expose ports
EXPOSE 80 3001

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/ && \
        wget --no-verbose --tries=1 --spider http://127.0.0.1:3001/api/health || exit 1

# Start both services
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/startup.sh"]
